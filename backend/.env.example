# MediKiosk Environment Configuration
# Copy this file to .env and fill in your details

# ─────────────────────────────────────────────────────────────────
# DATABASE URL
# ─────────────────────────────────────────────────────────────────
# Local Development (SQLite — default, no setup required)
DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db

# Production — Supabase PostgreSQL (Direct Connection, port 5432)
# Recommended for long-lived server deployments (e.g. Railway, Render, VPS)
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Production — Supabase PostgreSQL (Session Pooler, port 5432)
# Recommended when using a persistent server with connection pooling
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Production — Supabase PostgreSQL (Transaction Pooler, port 6543)
# Recommended for serverless/edge deployments (Vercel, AWS Lambda, etc.)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# NOTE: Bare postgresql:// and postgres:// URLs are also accepted and will be
# normalized automatically — no need to add +asyncpg manually.

# ─────────────────────────────────────────────────────────────────
# Gmail SMTP Configuration (Free Email Delivery)
# ─────────────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# 3. Fill in your Gmail address and the 16-character App Password below
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=MediKiosk <your_gmail_address@gmail.com>

# Demo mode toggle
DEMO_MODE=false
