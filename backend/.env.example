# MediKiosk Environment Configuration
# Copy this file to .env and fill in your details

# Database URL (Default: SQLite local database in backend folder)
DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db

# Resend API Key for digital health card and case history email delivery
# Get your free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Demo mode toggle
DEMO_MODE=false
